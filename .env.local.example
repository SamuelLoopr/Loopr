NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_PLACES_API_KEY=AIza...

# ElevenLabs Conversational AI — krävs för Test-fliken i agent-detaljvyn
# Skapa en agent på https://elevenlabs.io/app/conversational-ai och aktivera
# "Allow override" för System prompt-, First message- och Voice-fälten så att
# agentens prompt/hälsning/röst kan bytas ut per samtal.
# VIKTIGT: om "Allow override" inte är påslaget specifikt för Voice, skickar
# vår kod ett giltigt röst-ID men ElevenLabs IGNORERAR det helt tyst och
# använder agentens egen inställda röst — inget felmeddelande syns någonstans.
# Det är den vanligaste orsaken till att ett röstbyte i Inställningar-fliken
# inte hörs, även när allt annat (databas, API-anrop) är korrekt.
#
# SPRÅK/TTS-MODELL: agentens TTS-modell (t.ex. eleven_flash_v2_5 eller
# eleven_multilingual_v2 — båda är multilingual och stödjer svenska) går
# INTE att styra per samtal via vårt API-anrop ("model_id" finns inte som
# override-fält i ElevenLabs Conversational AI) — den sätts en gång på
# agenten i ElevenLabs dashboard under Voice → Model. Kontrollera där att
# en multilingual-modell är vald, inte en engelsk-only modell.
# De flesta färdiga röster i ett nytt ElevenLabs-konto är dessutom
# engelsktränade — de KAN tala svenska via en multilingual-modell men låter
# ofta engelskbrytna. Inställningar-fliken kan importera riktiga svenska
# röster direkt från ElevenLabs Voice Library (kräver betalt konto för vissa
# röster, andra är gratis).
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_AGENT_ID=agent_...

# Twilio — krävs för Telefon-fliken (sök/köp telefonnummer, ta emot samtal)
# Hitta dessa på https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Publik bas-URL dit Twilio kan nå din app för webhooks (t.ex. via ngrok i
# utveckling). Krävs för att inkommande samtal ska kunna kopplas vidare.
APP_BASE_URL=https://your-app.example.com

# Cal.com — krävs för Kalender-fliken (kontrollera lediga tider, boka möten)
# Hitta din API-nyckel under Settings → Developer → API Keys på cal.com
CAL_COM_API_KEY=cal_...

# Airtable — valfritt, för att synka samtalsloggar till en Airtable-bas
# från Samtal-fliken
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
